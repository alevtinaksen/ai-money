HOST=127.0.0.1
PORT=8000
DEBUG=true
APP_ENV=development
ALLOW_LOCAL_LOGIN=true
BOT_TOKEN=
WEBAPP_URL=http://127.0.0.1:5173
# DATABASE_URL omitted: local SQLite default.
# Optional prepared PostgreSQL schema. Blank keeps the default namespace.
DATABASE_SCHEMA=
# Optional extra trusted CA certificate; PostgreSQL always verifies TLS/hostname.
DATABASE_SSL_CA_FILE=
# Optional AI features require your own credentials, entered locally only.
AI_PROVIDER=disabled
AI_UPLOAD_CONSENT=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# API serves webhook only in explicit webhook mode; polling has one standalone owner.
TELEGRAM_MODE=polling
SERVER_URL=
TELEGRAM_WEBHOOK_SECRET=
